# KOSFintech environment configuration
# NEVER commit the real .env file.

BOT_TOKEN=
ADMIN_ID=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database
DB_FILE=data/kosfintech.db

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Security
SESSION_TIMEOUT_MINUTES=60
MAX_AI_TOOL_CALLS=5

# Global/community defaults
DEFAULT_COUNTRY=NG
DEFAULT_CURRENCY=NGN
